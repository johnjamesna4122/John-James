         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The intuitive supply chain</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Predict future disruptions and gain a competitive edge with the combined power of generative AI and cloud computing.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>IBM Institute for Business Value</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Artificial intelligence</rdf:li>
               <rdf:li>disruptions</rdf:li>
               <rdf:li>supply chain management</rdf:li>
