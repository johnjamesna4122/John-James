               <rdf:li>decision-making</rdf:li>
               <rdf:li>generative ai</rdf:li>
               <rdf:li>optimization</rdf:li>
               <rdf:li>ai-powered</rdf:li>
               <rdf:li>automation</rdf:li>
               <rdf:li>demand forecasting</rdf:li>
               <rdf:li>global supply chain</rdf:li>
               <rdf:li>inventory management</rdf:li>
               <rdf:li>machine learning</rdf:li>
               <rdf:li>supply chain operations</rdf:li>
               <rdf:li>sustainability</rdf:li>
               <rdf:li>supply chain planning</rdf:li>
               <rdf:li>predictive analytics</rdf:li>
               <rdf:li>simulations</rdf:li>
               <rdf:li>supply chain visibility</rdf:li>
